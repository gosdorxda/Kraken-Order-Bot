# KRKN.BOT — contoh environment variables
# Salin ke /opt/krkn-bot/.env di VPS lalu isi nilai aslinya.
# JANGAN commit file .env asli ke git.

NODE_ENV=production
PORT=8080

# Kraken API (wajib)
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# XT.com API (opsional — hanya jika pakai bot XT)
XT_API_KEY=
XT_API_SECRET=

# MEXC API (opsional — hanya jika pakai bot MEXC)
MEXC_API_KEY=
MEXC_API_SECRET=

# Dashboard login (wajib)
# SESSION_SECRET: generate dengan `openssl rand -hex 32`
DASHBOARD_PASSWORD=
SESSION_SECRET=

# Telegram notifikasi (opsional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Lokasi state bot (opsional, default: /var/lib/krkn-bot/data/state.json)
# DATA_PATH=/opt/krkn-bot/data/state.json

# Log level (opsional, default: info)
LOG_LEVEL=info
